# JANUS local voice runtime — example only.
# Copy to .env.voice.local and replace every absolute path locally.
# Never commit .env.voice.local, models, reference audio, or private voice configs.

# Janus Core -> local adapters
JANUS_STT_BASE_URL=http://127.0.0.1:8080
JANUS_TTS_BASE_URL=http://127.0.0.1:8090
JANUS_VOICE_ID=REPLACE_WITH_APPROVED_LOCAL_VOICE_ID
JANUS_STT_LANGUAGE=es
JANUS_TTS_LANGUAGE=Spanish
JANUS_TTS_CHUNK_MS=40
JANUS_TIME_ZONE=Europe/Amsterdam

# Qwen3-TTS sidecar
JANUS_QWEN_VOICE_CONFIG=/ABSOLUTE/LOCAL/PATH/janus-core/config/voices.local.json
JANUS_QWEN_HOST=127.0.0.1
JANUS_QWEN_PORT=8090
JANUS_QWEN_DEVICE=
JANUS_QWEN_ALLOW_REMOTE_MODEL_ID=false
JANUS_QWEN_ALLOW_REMOTE_BIND=false
JANUS_QWEN_HTTP_LOG=false

# whisper.cpp is launched separately and remains replaceable.
# Recommended local endpoint: http://127.0.0.1:8080
WHISPER_SERVER_BIN=/ABSOLUTE/LOCAL/PATH/whisper.cpp/build/bin/whisper-server
WHISPER_MODEL=/ABSOLUTE/LOCAL/PATH/whisper.cpp/models/ggml-small.bin
